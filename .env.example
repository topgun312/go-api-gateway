# --- PostgreSQL ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DSN для приложения. Должен совпадать с настройками Postgres выше.
DB_DSN=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Ollama ---
OLLAMA_URL=http://localhost:11434

# --- Шлюз ---
SERVER_PORT=:8080
MAX_REQUESTS=5